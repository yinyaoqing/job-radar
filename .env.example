# Copy to /opt/job-radar/.env on the host (or worker/.env locally). Never commit the real one.

# LLM extraction (job-radar extract). Leave empty to skip.
ANTHROPIC_API_KEY=
JOB_RADAR_EXTRACT_BUDGET=1

# Who is applying: eligibility and the digest use these.
JOB_RADAR_COUNTRY=TW
JOB_RADAR_UTC_OFFSET=8
# Comma list of domains for the digest, empty = all (engineering, data, product, design, ...)
JOB_RADAR_CATEGORIES=

# Daily digest email (job-radar digest --send). Leave SMTP_HOST empty to skip.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_FROM=
DIGEST_TO=
